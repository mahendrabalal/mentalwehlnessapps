# Production Environment Configuration
# Copy this file to .env.production and fill in your production values

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME="Mental Wellness App"
NEXT_PUBLIC_APP_VERSION=1.0.0

# Supabase Configuration (Production)
NEXT_PUBLIC_SUPABASE_URL=your-production-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Security Configuration
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=your-secure-secret-key-32-chars-minimum
NEXTAUTH_URL=https://your-domain.com

# Rate Limiting (Redis for production)
REDIS_URL=redis://your-redis-instance:6379
REDIS_PASSWORD=your-redis-password

# Error Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Email Service (for notifications)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@your-domain.com

# File Storage (for documents, exports)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# Monitoring and Health Checks
HEALTH_CHECK_TOKEN=your-health-check-secret-token
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=info

# Feature Flags
FEATURE_TELEHEALTH_INTEGRATION=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_MULTI_LANGUAGE=false

# Compliance and Audit
AUDIT_LOG_RETENTION_DAYS=2555 # 7 years for HIPAA compliance
HIPAA_COMPLIANCE_MODE=true
DATA_RESIDENCY_REGION=us

# External Service Integrations
CRISIS_TEXT_LINE_API_KEY=your-crisis-text-line-api-key
NATIONAL_SUICIDE_PREVENTION_API_KEY=your-nspl-api-key

# Performance and Caching
CDN_URL=https://your-cdn-domain.com
CACHE_TTL_SECONDS=3600
DATABASE_CONNECTION_LIMIT=20

# Legal and Terms
PRIVACY_POLICY_URL=https://your-domain.com/privacy
TERMS_OF_SERVICE_URL=https://your-domain.com/terms
HIPAA_BAA_URL=https://your-domain.com/hipaa-baa

# Development and Testing (Set to false in production)
ENABLE_DEBUG_MODE=false
ENABLE_TEST_ROUTES=false
SKIP_ENV_VALIDATION=false