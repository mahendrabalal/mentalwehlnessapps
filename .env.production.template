# Production Environment Configuration
# Mental Wellness App - HIPAA-Compliant Healthcare Authentication

# =======================
# APPLICATION SETTINGS
# =======================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://mentalwellness.yourdomain.com
NEXT_PUBLIC_APP_NAME="Mental Wellness Platform"

# =======================
# SUPABASE CONFIGURATION
# =======================
# Production Supabase Project Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Settings
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# =======================
# ENCRYPTION & SECURITY
# =======================
# Strong encryption key for PHI data (256-bit)
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=your-256-bit-encryption-key-here

# JWT Secret for additional security layers
JWT_SECRET=your-jwt-secret-key-here

# Session encryption key
SESSION_SECRET=your-session-secret-key-here

# =======================
# HEALTHCARE INTEGRATIONS
# =======================
# NPI (National Provider Identifier) Verification
NPPES_API_KEY=your-nppes-api-key
NPPES_API_URL=https://npiregistry.cms.hhs.gov/api

# State Medical Board APIs (example for California)
MEDICAL_BOARD_CA_API_KEY=your-ca-medical-board-api-key
MEDICAL_BOARD_CA_API_URL=https://www.mbc.ca.gov/api

# DEA Verification Service (requires licensed provider)
DEA_VERIFICATION_SERVICE_URL=https://your-dea-verification-service.com
DEA_VERIFICATION_API_KEY=your-dea-verification-api-key

# =======================
# COMMUNICATION SERVICES
# =======================
# Twilio for SMS/MFA
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid for Email
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME="Mental Wellness Platform"

# =======================
# CRISIS INTERVENTION
# =======================
# Crisis Text Line Integration
CRISIS_TEXT_LINE_API_KEY=your-crisis-text-line-api-key
CRISIS_TEXT_LINE_WEBHOOK_URL=https://your-domain.com/api/webhooks/crisis-text-line

# Emergency Services Integration
EMERGENCY_SERVICES_API_KEY=your-emergency-services-api-key
EMERGENCY_NOTIFICATION_WEBHOOK=https://your-domain.com/api/webhooks/emergency

# 988 Lifeline Integration
LIFELINE_988_WEBHOOK_URL=https://your-domain.com/api/webhooks/988-lifeline

# =======================
# MONITORING & LOGGING
# =======================
# Sentry for Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=mental-wellness-app

# DataDog for APM
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DD_SITE=datadoghq.com

# LogRocket for Session Replay (HIPAA-compliant configuration)
LOGROCKET_APP_ID=your-logrocket-app-id

# =======================
# ANALYTICS & COMPLIANCE
# =======================
# HIPAA-Compliant Analytics
HIPAA_ANALYTICS_ENDPOINT=https://your-hipaa-compliant-analytics.com
HIPAA_ANALYTICS_API_KEY=your-hipaa-analytics-api-key

# Compliance Monitoring
COMPLIANCE_MONITORING_WEBHOOK=https://your-compliance-monitoring.com/webhook
AUDIT_LOG_RETENTION_DAYS=2555 # 7 years for HIPAA compliance

# =======================
# HEALTHCARE STANDARDS
# =======================
# FHIR Server Configuration
FHIR_SERVER_URL=https://your-fhir-server.com/fhir/R4
FHIR_CLIENT_ID=your-fhir-client-id
FHIR_CLIENT_SECRET=your-fhir-client-secret

# HL7 Integration
HL7_ENDPOINT=https://your-hl7-endpoint.com
HL7_API_KEY=your-hl7-api-key

# =======================
# PAYMENT PROCESSING
# =======================
# Stripe for Healthcare Payments
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# =======================
# CDN & STORAGE
# =======================
# AWS S3 for HIPAA-Compliant File Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-hipaa-compliant-s3-bucket

# CloudFront CDN
AWS_CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id

# =======================
# RATE LIMITING & SECURITY
# =======================
# Redis for Rate Limiting
REDIS_URL=redis://your-redis-instance:6379
REDIS_PASSWORD=your-redis-password

# Rate Limiting Configuration
RATE_LIMIT_STANDARD=100
RATE_LIMIT_SENSITIVE=50
RATE_LIMIT_CLINICAL=25
RATE_LIMIT_EMERGENCY=200

# =======================
# BACKUP & DISASTER RECOVERY
# =======================
# Database Backup Configuration
BACKUP_S3_BUCKET=your-backup-s3-bucket
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM

# =======================
# FEATURE FLAGS
# =======================
# LaunchDarkly for Feature Management
LAUNCHDARKLY_SDK_KEY=your-launchdarkly-sdk-key
NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_ID=your-launchdarkly-client-id

# =======================
# DEVELOPMENT OVERRIDES
# =======================
# Set to true to enable development features in production (NOT RECOMMENDED)
ENABLE_DEV_FEATURES=false
ENABLE_DEBUG_LOGGING=false
BYPASS_HIPAA_CHECKS=false

# =======================
# SECURITY HEADERS
# =======================
# Content Security Policy
CSP_REPORT_URI=https://your-csp-reporting-endpoint.com/report

# HSTS Configuration
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# =======================
# HEALTH CHECKS
# =======================
HEALTH_CHECK_TOKEN=your-health-check-token
HEALTH_CHECK_ENDPOINTS=database,redis,external-apis

# =======================
# CERTIFICATE MANAGEMENT
# =======================
# SSL Certificate Configuration (if not using Vercel/auto-SSL)
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private-key.pem

# =======================
# MULTI-TENANT SETTINGS
# =======================
# Organization-specific settings
DEFAULT_ORGANIZATION_ID=your-default-org-id
MAX_ORGANIZATIONS_PER_USER=5
ENTERPRISE_FEATURES_ENABLED=true

# =======================
# INTEGRATION WEBHOOKS
# =======================
# EHR Integration Webhooks
EHR_WEBHOOK_SECRET=your-ehr-webhook-secret
EHR_WEBHOOK_ENDPOINTS=patient-update,appointment-create,clinical-note-add

# =======================
# COMPLIANCE REPORTING
# =======================
# Automated Compliance Reporting
COMPLIANCE_REPORT_EMAIL=compliance@yourdomain.com
COMPLIANCE_REPORT_SCHEDULE="0 0 1 * *" # Monthly on 1st
AUDIT_REPORT_RETENTION_YEARS=7

# =======================
# DISASTER RECOVERY
# =======================
# Failover Configuration
FAILOVER_DATABASE_URL=postgresql://postgres:password@failover-db.supabase.co:5432/postgres
FAILOVER_REDIS_URL=redis://failover-redis:6379
DISASTER_RECOVERY_REGION=us-west-2

# =======================
# PERFORMANCE MONITORING
# =======================
# Performance Thresholds
MAX_RESPONSE_TIME_MS=2000
MAX_CRISIS_RESPONSE_TIME_MS=500
MAX_DATABASE_QUERY_TIME_MS=1000

# =======================
# LEGAL & COMPLIANCE
# =======================
# Terms of Service and Privacy Policy
TERMS_OF_SERVICE_URL=https://yourdomain.com/terms
PRIVACY_POLICY_URL=https://yourdomain.com/privacy
HIPAA_NOTICE_URL=https://yourdomain.com/hipaa-notice

# BAA (Business Associate Agreement) Management
BAA_TEMPLATE_URL=https://yourdomain.com/baa-template
BAA_SIGNING_WEBHOOK=https://yourdomain.com/api/webhooks/baa-signed