{
  "name": "mental-wellness-app",
  "version": "1.0.0",
  "private": true,
  "description": "HIPAA-Compliant Mental Health Platform with Crisis Intervention and Healthcare Authentication",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npx --yes turbo run build",
    "dev": "npx --yes turbo run dev",
    "lint": "npx --yes turbo run lint",
    "test": "npx --yes turbo run test",
    "test:e2e": "npx --yes turbo run test:e2e",
    "type-check": "npx --yes turbo run type-check",
    "clean": "npx --yes turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "cd packages/database && npm run generate",
    "db:push": "cd packages/database && npm run push",
    "db:reset": "cd packages/database && npm run reset",
    "deploy:database": "psql $DATABASE_URL -f scripts/deploy-database.sql",
    "deploy:production": "npm run build && npm run deploy:vercel",
    "deploy:vercel": "vercel --prod",
    "cms:dev": "npm --workspace mental-wellness-cms run dev",
    "cms:build": "npm --workspace mental-wellness-cms run build",
    "cms:deploy": "npm --workspace mental-wellness-cms run deploy",
    "health:check": "curl -f http://localhost:3000/api/health || exit 1",
    "health:detailed": "curl -f http://localhost:3000/api/health-detailed || exit 1",
    "setup:production": "npm run setup:env && npm run deploy:database && npm run build",
    "setup:env": "cp .env.production.template .env.production",
    "quality:gates": "node scripts/run-quality-gates.js",
    "compliance:check": "node scripts/compliance-check.js",
    "backup:database": "node scripts/backup-database.js",
    "restore:database": "node scripts/restore-database.js",
    "monitor:start": "node scripts/start-monitoring.js",
    "monitor:alerts": "node scripts/check-alerts.js",
    "crisis:test": "node scripts/test-crisis-systems.js",
    "hipaa:audit": "node scripts/hipaa-audit.js"
  },
  "devDependencies": {
    "@mental-wellness/eslint-config": "file:./packages/config/eslint-config",
    "@mental-wellness/typescript-config": "file:./packages/config/typescript-config",
    "@playwright/test": "^1.55.1",
    "@supabase/supabase-js": "^2.58.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^3.0.1",
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@playwright/mcp": "^0.0.40",
    "@stripe/mcp": "^0.2.4"
  }
}
